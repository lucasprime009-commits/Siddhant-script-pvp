local function getClosestTargetToMouse()
local targetCharacter = nil
local maxDistance = _G.G_S_InfiniteRange and 99999 or _G.G_S_SilentAimFOV
local mousePos = UIS:GetMouseLocation()
local function evaluateTarget(character)
if character and character:FindFirstChild(_G.G_S_SilentAimPart) then
local enemyHum = character:FindFirstChildOfClass("Humanoid")
if enemyHum and enemyHum.Health > 0 then
local targetPart = character[_G.G_S_SilentAimPart]
local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
if onScreen or _G.G_S_InfiniteRange then
local deltaDistance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
if deltaDistance < maxDistance then
maxDistance = deltaDistance
targetCharacter = character
end
end
end
end
end
if _G.G_S_SilentAimTargetPlayers then
for _, player in ipairs(Players:GetPlayers()) do
if player ~= LocalPlayer and (_G.G_S_SilentAimTeamCheck == false or player.Team ~= LocalPlayer.Team) then
evaluateTarget(player.Character)
end
end
end
if _G.G_S_SilentAimTargetMobs and Workspace:FindFirstChild("Enemies") then
for _, npc in ipairs(Workspace.Enemies:GetChildren()) do
evaluateTarget(npc)
end
end
return targetCharacter
end
local rawMetatable = getrawmetatable(game)
local oldIndex = rawMetatable.__index
setreadonly(rawMetatable, false)
rawMetatable.__index = newcclosure(function(self, index)
if _G.G_S_SilentAimM1R and tostring(self) == "Mouse" and (index == "Hit" or index == "Target") then
local currentTarget = getClosestTargetToMouse()
if currentTarget and currentTarget:FindFirstChild(_G.G_S_SilentAimPart) then
if index == "Hit" then return currentTarget[_G.G_S_SilentAimPart].CFrame
elseif index == "Target" then return currentTarget[_G.G_S_SilentAimPart] end
end
end
return oldIndex(self, index)
end)
setreadonly(rawMetatable, true)
